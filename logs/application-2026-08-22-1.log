<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.quanxiaoha</groupId>
    <artifactId>xiaoha-mcp-server-qq</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>xiaoha-mcp-server-qq</name>
    <description>MCP Server: 获取 QQ 信息</description>
    <properties>
        <!-- JDK 版本 -->
        <java.version>21</java.version>
        <!-- Spring AI 版本 -->
        <spring-ai.version>2.0.0</spring-ai.version>
        <lombok.version>1.18.30</lombok.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 避免编写那些冗余的 Java 样板式代码，如 get、set 方法等 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <!-- 添加华为云、阿里云 maven 中央仓库，提升 Jar 包下载速度 -->
        <repository>
            <id>huaweicloud</id>
            <name>huawei</name>
            <url>https://mirrors.huaweicloud.com/repository/maven/</url>
        </repository>
        <repository>
            <id>aliyunmaven</id>
            <name>aliyun</name>
            <url>https://maven.aliyun.com/repository/public</url>
        </repository>
    </repositories>

</project>

', media='null', metadata={originalFileName=7.4 搭建自定义 MCP Server：获取 QQ 信息.md, mdStorageId=65, category=code_block, lang=}, score=null}, Document{id='a6223618-3d14-40a1-9019-a1b529d041f9', text='在 Spring AI 项目中，MCP Server 支持三种部署模式，下面是对比表格，涵盖核心特性、适用场景及配置要点：| 对比维度        | STDIO 模式                                               | WebMVC 模式                                              | WebFlux 模式                                             | | :------------------ | :----------------------------------------------------------- | :----------------------------------------------------------- | :----------------------------------------------------------- | | 依赖项          | spring-ai-starter-mcp-server                               | spring-ai-starter-mcp-server-webmvc                        | spring-ai-starter-mcp-server-webflux                       | | 传输机制（2.0） | STDIO（进程内标准 I/O）                                      | Streamable-HTTP（推荐）/ SSE（已废弃）/ Stateless            | Streamable-HTTP（推荐）/ SSE（已废弃）/ Stateless            | | 启用配置        | spring.ai.mcp.server.stdio=true                            | spring.ai.mcp.server.protocol=STREAMABLE（或 SSE / STATELESS） | spring.ai.mcp.server.protocol=STREAMABLE（或 SSE / STATELESS） | | HTTP 栈         | 无 Web 服务                                                  | Servlet 阻塞（Tomcat / Jetty）                               | 响应式非阻塞（Netty）                                        | | 服务端类型      | 默认 SYNC，可设 ASYNC                                        | 默认 SYNC，可设 ASYNC                                        | 默认 SYNC，可设 ASYNC                                        | | 服务端类型控制  | spring.ai.mcp.server.type=SYNC\|ASYNC                      | spring.ai.mcp.server.type=SYNC\|ASYNC                      | spring.ai.mcp.server.type=SYNC\|ASYNC                      | | 适用场景        | 命令行工具、桌面宿主、无网络环境（如 Claude Desktop、Cursor） | 传统 Spring MVC 应用                                         | 高并发微服务、云原生架构                                     | | 实践注意        | 2.0 用独立 starter，无需手动 web-application-type=none     | STDIO 可与 HTTP 协议共存（stdio=true）                     | 避免与 spring-boot-starter-web 同存，否则自动装配冲突      | | 性能特点        | 低延迟，轻量级                                               | 中等并发能力，依赖线程池                                     | 高并发，低资源消耗（线程复用）                               |这里我们选择支持更高并发的 WebFlux 模式，再次编辑 pom.xml， 添加如下依赖：', media='null', metadata={originalFileName=7.4 搭建自定义 MCP Server：获取 QQ 信息.md, mdStorageId=65, category=code_inline, title=MCP Server 三种部署模式}, score=null}, Document{id='76f9a3d3-76ed-41ff-acc9-045111044adb', text='        <!-- MCP Server WebFlux -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webflux</artifactId>
        </dependency>
', media='null', metadata={originalFileName=7.4 搭建自定义 MCP Server：获取 QQ 信息.md, mdStorageId=65, category=code_block, lang=}, score=null}, Document{id='8fde8975-b8f2-4ee6-8676-2ae750edf4b4', text='依赖添加完成后，记得刷新一下 Maven, 将依赖下载到本地 Maven 仓库中。', media='null', metadata={originalFileName=7.4 搭建自定义 MCP Server：获取 QQ 信息.md, mdStorageId=65}, score=null}, Document{id='382c4347-10f0-43d2-b21e-11ba358ad7c0', text='然后，编辑 applicaiton.yml， 添加配置项如下：', media='null', metadata={originalFileName=7.4 搭建自定义 MCP Server：获取 QQ 信息.md, mdStorageId=65, category=code_inline, title=添加配置}, score=null}, Document{id='ddde368e-5188-4b40-85b1-76c407882c91', text='server:
  port: 8000 # 启动端口号

spring:
  ai:
    mcp:
      server:
        type: sync # 处理模式，SYNC 同步或 ASYNC 异步
        name: mcp-server-qq # MCP Server 名称
        version: 1.0.0 # MCP Server 版本号

# 鬼鬼 API Key(替换为你自己的)
api-key: xxx
', media='null', metadata={originalFileName=7.4 搭建自定义 MCP Server：获取 QQ 信息.md, mdStorageId=65, category=code_block, lang=}, score=null}, Document{id='b50c7b99-d11e-434a-804c-d82d63479efe', text='注意：根据 QQ 号查询 QQ 信息，需要调用鬼鬼第三方平台的 API,  需要先申请 API Key, 如何申请可参考《前后端分离博客2期》的《6.2节》，本小节不再赘述。', media='null', metadata={originalFileName=7.4 搭建自定义 MCP Server：获取 QQ 信息.md, category=blockquote, mdStorageId=65}, score=null}, Document{id='a16d4edc-e115-48b8-bc30-ba53cd1b5146', text='因为业务涉及到 Http 调用第三方平台，咱们先来配置一下 RestTemplate。新增 /config 包，并新建 RestTemplateConfig 配置类，如下：', media='null', metadata={originalFileName=7.4 搭建自定义 MCP Server：获取 QQ 信息.md, mdStorageId=65, category=code_inline, title=配置 RestTemplate}, score=null}, Document{id='c2eb54fa-7fba-4e80-bbfd-2d3b394001a5', text='package com.quanxiaoha.mcp.qq.config;

import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.http.client.SimpleClientHttpRequestFactory;
import org.springframework.web.client.RestTemplate;

/**
 * @Author: 犬小哈
 * @Date: 2025/7/12 19:12
 * @Version: v1.0.0
 * @Description: RestTemplate 配置类
 **/
@Configuration
public class RestTemplateConfig {

    @Bean
    public RestTemplate restTemplate() {
        SimpleClientHttpRequestFactory factory = new SimpleClientHttpRequestFactory();
        factory.setConnectTimeout(10000); // 连接超时时间：10秒
        factory.setReadTimeout(10000); // 读取超时时间：10秒
        return new RestTemplate(factory);
    }
}
', media='null', metadata={originalFileName=7.4 搭建自定义 MCP Server：获取 QQ 信息.md, mdStorageId=65, category=code_block, lang=}, score=null}, Document{id='59fa7ca8-d49d-4cce-ae37-f3bce311ea9b', text='接着，新建一个 /tools 包，并通过 @Tool 注解声明一个 “根据 QQ 号获取 QQ 信息”  工具方法，模式和之前定义 Function Call 差不太多，代码如下：', media='null', metadata={originalFileName=7.4 搭建自定义 MCP Server：获取 QQ 信息.md, mdStorageId=65, category=code_inline, title=定义 Tool}, score=null}, Document{id='f8b1adc8-aa7b-40bd-a5bf-e4826bdabaeb', text='package com.quanxiaoha.mcp.qq.tool;

import jakarta.annotation.Resource;
import lombok.extern.slf4j.Slf4j;
import org.springframework.ai.tool.annotation.Tool;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Component;
import org.springframework.web.client.RestTemplate;

/**
 * @Author: 犬小哈
 * @Date: 2026/6/30 18:50
 * @Version: v1.0.0
 * @Description: QQ Tool 工具
 **/
@Component
@Slf4j
public class QQTool {

    @Resource
    private RestTemplate restTemplate;

    @Value("${api-key}")
    private String apiKey;

    @Tool(description = "根据 QQ 号获取 QQ 信息")
    public String getQQInfo(String qq) {
        log.info("## 获取 QQ 信息, qq: {}", qq);

        // 请求第三方接口
        String url = String.format("http://api.guiguiya.com/api/qq_info?qq=%s&apiKey=%s", qq, apiKey);
        String result = restTemplate.getForObject(url, String.class);

        log.info("## 返参: {}", result);
        return result;
    }

}

', media='null', metadata={originalFileName=7.4 搭建自定义 MCP Server：获取 QQ 信息.md, mdStorageId=65, category=code_block, lang=}, score=null}, Document{id='17e9cadd-1f3c-43c2-994f-127ecf64117e', text='完成以上工作后，编辑 XiaohaMcpServerQqApplication 启动类，注册工具回调（Tool Callbacks），代码如下：', media='null', metadata={originalFileName=7.4 搭建自定义 MCP Server：获取 QQ 信息.md, mdStorageId=65, category=code_inline, title=注册工具}, score=null}, Document{id='c7081906-0dae-4dcf-be75-5d0643d9f90d', text='package com.quanxiaoha.mcp.server.qq;

import com.quanxiaoha.mcp.server.qq.tools.QQTool;
import org.springframework.ai.tool.ToolCallbackProvider;
import org.springframework.ai.tool.method.MethodToolCallbackProvider;
import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;
import org.springframework.context.annotation.Bean;

@SpringBootApplication
public class XiaohaMcpServerQqApplication {

    public static void main(String[] args) {
        SpringApplication.run(XiaohaMcpServerQqApplication.class, args);
    }

    /**
     * 注册工具回调（Tool Callbacks）
     * @param qqTool
     * @return
     */
    @Bean
    public ToolCallbackProvider qqTools(QQTool qqTool) {
        return MethodToolCallbackProvider.builder()
                .toolObjects(qqTool)
                .build();
    }

}

', media='null', metadata={originalFileName=7.4 搭建自定义 MCP Server：获取 QQ 信息.md, mdStorageId=65, category=code_block, lang=}, score=null}, Document{id='75d7d8ed-b13a-4955-9f3f-7a83d08bd261', text='最后，重启后端项目，观察控制台日志，如下图所示，若包含提示信息 Registered tools: 1 , 表示已注册了一个工具，到此，一个简单的 MCP Server 就跑起来了！', media='null', metadata={originalFileName=7.4 搭建自定义 MCP Server：获取 QQ 信息.md, mdStorageId=65, category=code_inline, title=测试一下}, score=null}]
