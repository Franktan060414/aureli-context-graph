2026-08-22 21:12:18.270 [event-handler-1] INFO  listener.event.com.aureli.ai.robot.AiCustomerServiceMdUploadedListener - ## documents: [Document{id='9889e0f5-5a01-4ee8-bcbd-e30bc8a83c5c', text='上小节中，我们使用 MCP Client 对接了第三方提供的 MCP Server 服务 —— 高德地图。那能否自行搭建一个 MCP Server 服务呢？答案是肯定的。本小节中，我们就来尝试一下，将星球第一个项目《前后端分离博客》中的 “根据 QQ 号获取 QQ 信息接口” 接口，打包到 MCP Server 服务中，以工具的方式提供出来。', media='null', metadata={originalFileName=7.4 搭建自定义 MCP Server：获取 QQ 信息.md, mdStorageId=64}, score=null}, Document{id='5b6a8652-b839-45fb-90a5-a880c35b6ed6', text='打开 IDEA, 依次点击左上角菜单 File -> New -> Project ，准备创建一个新项目：在弹框中，填写配置项如下：', media='null', metadata={originalFileName=7.4 搭建自定义 MCP Server：获取 QQ 信息.md, mdStorageId=64, category=header_2, title=新建 MCP Server 项目}, score=null}, Document{id='fd4bea54-46d1-4eba-b285-14d608d05bc7', text='①：选择 Spring Boot 生成器来创建项目； ②：项目名称填写 xiaoha-mcp-server-qq； ③: 项目存放位置，选择之前创建好的 /xiaoha-ai-robot 文件夹； ④：项目构建方式选择 Maven; ⑤：填写 Group 组织名称，通常为公司域名倒写，如 com.quanxiaoha； ⑥： 项目唯一标识符，这里填写 xiaoha-mcp-server-qq; ⑦： 包名填写 com.quanxiaoha.mcp.qq; ⑧: JDK 版本选择 21 版本； ⑨： Java 语言版本也选择 21， 和 JDK 保持一致；配置文件格式使用 YAML;都填写完毕后，点击 Next 按钮，进入到下一步，如下图所示：无需勾选任何依赖，直接点击 Create 按钮：项目创建成功后，将上图标注的、不需要的文件与文件夹都删除掉。', media='null', metadata={originalFileName=7.4 搭建自定义 MCP Server：获取 QQ 信息.md, category=code_inline, mdStorageId=64}, score=null}, Document{id='05d0509a-7fa1-47e7-a50b-a9d9cd16d4c8', text='接着，编辑  pom.xml 文件，首先将 Spring Boot 的版本号修改为 4.1.0, 保持和 AI 机器人项目版本一致，防止有兼容性问题。另外，添加 Spring AI 框架的依赖管理、 lombok 工具依赖、仓库地址等，如下：', media='null', metadata={originalFileName=7.4 搭建自定义 MCP Server：获取 QQ 信息.md, mdStorageId=64, category=code_inline, title=修改 pom.xml}, score=null}, Document{id='540c18a6-da5f-450a-b40e-6807bed658b2', text='<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.quanxiaoha</groupId>
    <artifactId>xiaoha-mcp-server-qq</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>xiaoha-mcp-server-qq</name>
    <description>MCP Server: 获取 QQ 信息</description>
    <properties>
        <!-- JDK 版本 -->
        <java.version>21</java.version>
        <!-- Spring AI 版本 -->
        <spring-ai.version>2.0.0</spring-ai.version>
        <lombok.version>1.18.30</lombok.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 避免编写那些冗余的 Java 样板式代码，如 get、set 方法等 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <!-- 添加华为云、阿里云 maven 中央仓库，提升 Jar 包下载速度 -->
        <repository>
            <id>huaweicloud</id>
            <name>huawei</name>
            <url>https://mirrors.huaweicloud.com/repository/maven/</url>
        </repository>
        <repository>
            <id>aliyunmaven</id>
            <name>aliyun</name>
            <url>https://maven.aliyun.com/repository/public</url>
        </repository>
    </repositories>

</project>

', media='null', metadata={originalFileName=7.4 搭建自定义 MCP Server：获取 QQ 信息.md, mdStorageId=64, category=code_block, lang=}, score=null}, Document{id='11a24b52-7c24-48e7-8358-7cda3f928c27', text='在 Spring AI 项目中，MCP Server 支持三种部署模式，下面是对比表格，涵盖核心特性、适用场景及配置要点：| 对比维度        | STDIO 模式                                               | WebMVC 模式                                              | WebFlux 模式                                             | | :------------------ | :----------------------------------------------------------- | :----------------------------------------------------------- | :----------------------------------------------------------- | | 依赖项          | spring-ai-starter-mcp-server                               | spring-ai-starter-mcp-server-webmvc                        | spring-ai-starter-mcp-server-webflux                       | | 传输机制（2.0） | STDIO（进程内标准 I/O）                                      | Streamable-HTTP（推荐）/ SSE（已废弃）/ Stateless            | Streamable-HTTP（推荐）/ SSE（已废弃）/ Stateless            | | 启用配置        | spring.ai.mcp.server.stdio=true                            | spring.ai.mcp.server.protocol=STREAMABLE（或 SSE / STATELESS） | spring.ai.mcp.server.protocol=STREAMABLE（或 SSE / STATELESS） | | HTTP 栈         | 无 Web 服务                                                  | Servlet 阻塞（Tomcat / Jetty）                               | 响应式非阻塞（Netty）                                        | | 服务端类型      | 默认 SYNC，可设 ASYNC                                        | 默认 SYNC，可设 ASYNC                                        | 默认 SYNC，可设 ASYNC                                        | | 服务端类型控制  | spring.ai.mcp.server.type=SYNC\|ASYNC                      | spring.ai.mcp.server.type=SYNC\|ASYNC                      | spring.ai.mcp.server.type=SYNC\|ASYNC                      | | 适用场景        | 命令行工具、桌面宿主、无网络环境（如 Claude Desktop、Cursor） | 传统 Spring MVC 应用                                         | 高并发微服务、云原生架构                                     | | 实践注意        | 2.0 用独立 starter，无需手动 web-application-type=none     | STDIO 可与 HTTP 协议共存（stdio=true）                     | 避免与 spring-boot-starter-web 同存，否则自动装配冲突      | | 性能特点        | 低延迟，轻量级                                               | 中等并发能力，依赖线程池                                     | 高并发，低资源消耗（线程复用）                               |这里我们选择支持更高并发的 WebFlux 模式，再次编辑 pom.xml， 添加如下依赖：', media='null', metadata={originalFileName=7.4 搭建自定义 MCP Server：获取 QQ 信息.md, mdStorageId=64, category=code_inline, title=MCP Server 三种部署模式}, score=null}, Document{id='f07f2929-af1f-4292-b1f0-9b3aada64625', text='        <!-- MCP Server WebFlux -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webflux</artifactId>
        </dependency>
', media='null', metadata={originalFileName=7.4 搭建自定义 MCP Server：获取 QQ 信息.md, mdStorageId=64, category=code_block, lang=}, score=null}, Document{id='a59b6afd-1628-479c-95a0-9df043696728', text='依赖添加完成后，记得刷新一下 Maven, 将依赖下载到本地 Maven 仓库中。', media='null', metadata={originalFileName=7.4 搭建自定义 MCP Server：获取 QQ 信息.md, mdStorageId=64}, score=null}, Document{id='56efac27-3bb0-4fbb-9354-39f8de9c1c7a', text='然后，编辑 applicaiton.yml， 添加配置项如下：', media='null', metadata={originalFileName=7.4 搭建自定义 MCP Server：获取 QQ 信息.md, mdStorageId=64, category=code_inline, title=添加配置}, score=null}, Document{id='6b9234d9-a6c7-4fd7-bdbd-784599d237fc', text='server:
  port: 8000 # 启动端口号

spring:
  ai:
    mcp:
      server:
        type: sync # 处理模式，SYNC 同步或 ASYNC 异步
        name: mcp-server-qq # MCP Server 名称
        version: 1.0.0 # MCP Server 版本号

# 鬼鬼 API Key(替换为你自己的)
api-key: xxx
', media='null', metadata={originalFileName=7.4 搭建自定义 MCP Server：获取 QQ 信息.md, mdStorageId=64, category=code_block, lang=}, score=null}, Document{id='68ca8617-ee8b-4c36-8ee0-efd7a18759e7', text='注意：根据 QQ 号查询 QQ 信息，需要调用鬼鬼第三方平台的 API,  需要先申请 API Key, 如何申请可参考《前后端分离博客2期》的《6.2节》，本小节不再赘述。', media='null', metadata={originalFileName=7.4 搭建自定义 MCP Server：获取 QQ 信息.md, category=blockquote, mdStorageId=64}, score=null}, Document{id='6291d7b5-aaf4-46c6-a2ce-eddd82c4526b', text='因为业务涉及到 Http 调用第三方平台，咱们先来配置一下 RestTemplate。新增 /config 包，并新建 RestTemplateConfig 配置类，如下：', media='null', metadata={originalFileName=7.4 搭建自定义 MCP Server：获取 QQ 信息.md, mdStorageId=64, category=code_inline, title=配置 RestTemplate}, score=null}, Document{id='281bd8cf-9d87-41fb-b947-f2a215b1ed00', text='package com.quanxiaoha.mcp.qq.config;

import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.http.client.SimpleClientHttpRequestFactory;
import org.springframework.web.client.RestTemplate;

/**
 * @Author: 犬小哈
 * @Date: 2025/7/12 19:12
 * @Version: v1.0.0
 * @Description: RestTemplate 配置类
 **/
@Configuration
public class RestTemplateConfig {

    @Bean
    public RestTemplate restTemplate() {
        SimpleClientHttpRequestFactory factory = new SimpleClientHttpRequestFactory();
        factory.setConnectTimeout(10000); // 连接超时时间：10秒
        factory.setReadTimeout(10000); // 读取超时时间：10秒
        return new RestTemplate(factory);
    }
}
', media='null', metadata={originalFileName=7.4 搭建自定义 MCP Server：获取 QQ 信息.md, mdStorageId=64, category=code_block, lang=}, score=null}, Document{id='5471582c-8b20-46e3-8678-ccc2e35dc954', text='接着，新建一个 /tools 包，并通过 @Tool 注解声明一个 “根据 QQ 号获取 QQ 信息”  工具方法，模式和之前定义 Function Call 差不太多，代码如下：', media='null', metadata={originalFileName=7.4 搭建自定义 MCP Server：获取 QQ 信息.md, mdStorageId=64, category=code_inline, title=定义 Tool}, score=null}, Document{id='88e12bd0-350e-44b5-8b9b-5d46efdd7ff4', text='package com.quanxiaoha.mcp.qq.tool;

import jakarta.annotation.Resource;
import lombok.extern.slf4j.Slf4j;
import org.springframework.ai.tool.annotation.Tool;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Component;
import org.springframework.web.client.RestTemplate;

/**
 * @Author: 犬小哈
 * @Date: 2026/6/30 18:50
 * @Version: v1.0.0
 * @Description: QQ Tool 工具
 **/
@Component
@Slf4j
public class QQTool {

    @Resource
    private RestTemplate restTemplate;

    @Value("${api-key}")
    private String apiKey;

    @Tool(description = "根据 QQ 号获取 QQ 信息")
    public String getQQInfo(String qq) {
        log.info("## 获取 QQ 信息, qq: {}", qq);

        // 请求第三方接口
        String url = String.format("http://api.guiguiya.com/api/qq_info?qq=%s&apiKey=%s", qq, apiKey);
        String result = restTemplate.getForObject(url, String.class);

        log.info("## 返参: {}", result);
        return result;
    }

}

', media='null', metadata={originalFileName=7.4 搭建自定义 MCP Server：获取 QQ 信息.md, mdStorageId=64, category=code_block, lang=}, score=null}, Document{id='786a932a-6a87-4aea-80b0-8651035a0b76', text='完成以上工作后，编辑 XiaohaMcpServerQqApplication 启动类，注册工具回调（Tool Callbacks），代码如下：', media='null', metadata={originalFileName=7.4 搭建自定义 MCP Server：获取 QQ 信息.md, mdStorageId=64, category=code_inline, title=注册工具}, score=null}, Document{id='870827d4-ddc7-49e6-b629-d781606a3912', text='package com.quanxiaoha.mcp.server.qq;

import com.quanxiaoha.mcp.server.qq.tools.QQTool;
import org.springframework.ai.tool.ToolCallbackProvider;
import org.springframework.ai.tool.method.MethodToolCallbackProvider;
import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;
import org.springframework.context.annotation.Bean;

@SpringBootApplication
public class XiaohaMcpServerQqApplication {

    public static void main(String[] args) {
        SpringApplication.run(XiaohaMcpServerQqApplication.class, args);
    }

    /**
     * 注册工具回调（Tool Callbacks）
     * @param qqTool
     * @return
     */
    @Bean
    public ToolCallbackProvider qqTools(QQTool qqTool) {
        return MethodToolCallbackProvider.builder()
                .toolObjects(qqTool)
                .build();
    }

}

', media='null', metadata={originalFileName=7.4 搭建自定义 MCP Server：获取 QQ 信息.md, mdStorageId=64, category=code_block, lang=}, score=null}, Document{id='ac51ac87-23ef-42a7-a705-81442ce872b7', text='最后，重启后端项目，观察控制台日志，如下图所示，若包含提示信息 Registered tools: 1 , 表示已注册了一个工具，到此，一个简单的 MCP Server 就跑起来了！', media='null', metadata={originalFileName=7.4 搭建自定义 MCP Server：获取 QQ 信息.md, mdStorageId=64, category=code_inline, title=测试一下}, score=null}]
